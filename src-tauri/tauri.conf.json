{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Otium Downloader",
  "version": "1.1.0",
  "identifier": "com.otium.downloader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Otium Downloader",
        "url": "index.html",
        "width": 980,
        "height": 720,
        "minWidth": 460,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' https://tauri.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost https://tauri.localhost https://api.github.com https://github.com https://raw.githubusercontent.com *",
        "font-src": "'self' data: https://tauri.localhost",
        "img-src": "'self' data: blob: https://tauri.localhost *",
        "media-src": "'self' blob: data: https://tauri.localhost *",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "worker-src": "'self' blob:",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "opener": {},
    "updater": {
      "endpoints": [
        "https://github.com/XRTM8/Otium-Downloader/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0MjQ2RTRENjMyMDE4RUMKUldUc0dDQmpUVzRrWkNnc3J5VS9mVTFIdVlMMVpUU2hUZWRlSHRaRE5BVnJoeG13aCtkUGNtOHEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
